name: '🚀 AnimeVerso'
description: 'Solicitar a criação de um novo projeto na organização'
title: '[AnimeVerso] Solicitação de criação de projeto'
labels: ['AnimeVerso', 'em-análise']
body:
  - type: markdown
    attributes:
      value: 'Obrigado por propor um novo projeto! Por favor, preencha as informações abaixo para que possamos avaliar sua solicitação.'

  - type: input
    id: project-name
    attributes:
      label: 'Nome do Projeto'
      description: 'Digite o nome do novo projeto'
      placeholder: 'AnimeVerso'
    validations:
      required: true

  - type: textarea
    id: project-description
    attributes:
      label: 'Descrição do Projeto'
      description: 'Forneça uma breve descrição do projeto, seus objetivos e possíveis benefícios'
      placeholder: |
        AnimeVerso é uma plataforma que visa criar uma área onde fãs de anime possam jogar RPG de forma imersiva. 
        Permitirá divisão em vilas, clãs, além de controle de fichas, status (vida, chakra/mana, buffs/debuffs).
        Terá um site Web integrado com bots no Discord para dar suporte às narrativas e partidas de RPG.
    validations:
      required: true

  - type: dropdown
    id: use-github-projects
    attributes:
      label: 'Usar GitHub Projects?'
      description: 'O projeto utilizará o GitHub Projects para gestão de tarefas?'
      options:
        - 'Sim'
    validations:
      required: true

  - type: checkboxes
    id: repositories
    attributes:
      label: 'Repositórios a serem criados'
      description: 'Selecione os repositórios necessários para o projeto'
      options:
        - label: 'Back-end'
        - label: 'Front-end'
        - label: 'Design (apenas se usar GitHub Projects)'
    validations:
      required: true

  - type: input
    id: github-username
    attributes:
      label: 'Seu Username no GitHub'
      description: 'Digite seu nome de usuário no GitHub'
      placeholder: 'alvarowisky'
    validations:
      required: true

  - type: input
    id: discord-username
    attributes:
      label: 'Seu Username no Discord'
      description: 'Digite seu nome de usuário no Discord'
      placeholder: 'wisky9169'
    validations:
      required: true

  - type: markdown
    attributes:
      value: 'Obrigado por preencher todas as informações. Sua solicitação será analisada em breve.'

